<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aegis_bg">

    <com.example.aegis.ui.hud.HudGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="40dp">

                <com.example.aegis.ui.hud.IronHelmetView
                    android:id="@+id/helmet"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <com.example.aegis.ui.hud.ScanRingView
                    android:id="@+id/deployRing"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/code"
                style="@style/Aegis.Title"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:textSize="26sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/nickname"
                style="@style/Aegis.Label"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/aegis_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/meta"
                style="@style/Aegis.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/aegis_text_dim" />

            <TextView
                android:id="@+id/status"
                style="@style/Aegis.Label"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

            <TextView
                style="@style/Aegis.Section"
                android:text="@string/about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/description"
                style="@style/Aegis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Aegis.Section"
                android:text="@string/specs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

            <com.example.aegis.ui.hud.StatRadarView
                android:id="@+id/radar"
                android:layout_width="match_parent"
                android:layout_height="250dp" />

            <TextView
                style="@style/Aegis.Section"
                android:text="@string/weapons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/weapons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deploy"
                style="@style/Aegis.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="@string/deploy" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_widget"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:tint="@color/aegis_cyan" />

    <com.example.aegis.ui.hud.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
