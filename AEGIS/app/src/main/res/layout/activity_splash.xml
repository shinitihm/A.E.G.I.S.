<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aegis_bg">

    <com.example.aegis.ui.hud.HudGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.example.aegis.ui.hud.ArcReactorView
            android:id="@+id/reactor"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:alpha="0" />

        <TextView
            android:id="@+id/logo"
            style="@style/Aegis.Title"
            android:layout_marginTop="24dp"
            android:alpha="0"
            android:text="@string/app_name"
            android:textSize="38sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tagline"
            style="@style/Aegis.Label"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/app_full_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/bootLog"
            style="@style/Aegis.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:textColor="@color/aegis_cyan"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/bootProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="36dp"
            android:max="100"
            android:progressBackgroundTint="@color/aegis_cyan_faint"
            android:progressTint="@color/aegis_cyan" />
    </LinearLayout>
</FrameLayout>
