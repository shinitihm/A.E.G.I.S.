<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aegis_bg">

    <com.example.aegis.ui.hud.HudGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            style="@style/Aegis.Title"
            android:layout_marginTop="48dp"
            android:text="@string/auth_title"
            android:textSize="17sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

        <TextView
            style="@style/Aegis.Label"
            android:layout_marginTop="6dp"
            android:text="@string/auth_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/scanner"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:clickable="true"
            android:focusable="true">

            <com.example.aegis.ui.hud.ScanRingView
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/fingerprint"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:contentDescription="@string/auth_idle"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/aegis_cyan"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <View
                android:id="@+id/scanLine"
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/aegis_cyan"
                android:visibility="invisible" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            style="@style/Aegis.Heading"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:minLines="2"
            android:text="@string/auth_idle"
            android:textColor="@color/aegis_cyan"
            android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            style="@style/Aegis.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/auth_retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emergency"
            style="@style/Aegis.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:text="@string/auth_emergency"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
