<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Aegis.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    app:strokeColor="@color/aegis_cyan">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.aegis.ui.hud.ArcReactorView
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                style="@style/Aegis.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/briefing_title" />
        </LinearLayout>

        <!-- 1) pergunta -->
        <LinearLayout
            android:id="@+id/askGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/Aegis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/briefing_ask" />

            <TextView
                style="@style/Aegis.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/briefing_city_label" />

            <EditText
                android:id="@+id/city"
                style="@style/Aegis.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/briefing_city_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/no"
                    style="@style/Aegis.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/briefing_no" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/yes"
                    style="@style/Aegis.Button.Gold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/briefing_yes" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2) carregando / erro de rede -->
        <com.example.aegis.ui.hud.StateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 3) resultado -->
        <LinearLayout
            android:id="@+id/resultGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/cityLabel"
                style="@style/Aegis.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/temp"
                style="@style/Aegis.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/rain"
                style="@style/Aegis.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Aegis.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/briefing_news_label" />

            <LinearLayout
                android:id="@+id/newsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/newsError"
                style="@style/Aegis.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/change"
                    style="@style/Aegis.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/briefing_change_city"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/close"
                    style="@style/Aegis.Button.Gold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/briefing_close" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
