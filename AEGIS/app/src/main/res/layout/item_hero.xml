<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Aegis.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@color/aegis_surface_2"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/Aegis.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Aegis.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/aegis_text_dim"
                android:textSize="12sp" />

            <com.example.aegis.ui.hud.ThreatMeterView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/threat"
                style="@style/Aegis.Label"
                android:layout_marginTop="4dp"
                android:textSize="10sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageView
            android:id="@+id/monitored"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/monitoring"
            android:src="@drawable/ic_nav_targets"
            android:visibility="gone"
            app:tint="@color/aegis_gold"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
