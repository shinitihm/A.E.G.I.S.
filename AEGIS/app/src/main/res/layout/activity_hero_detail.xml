<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aegis_bg">

    <com.example.aegis.ui.hud.HudGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="340dp">

                <ImageView
                    android:id="@+id/photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_fade" />

                <com.example.aegis.ui.hud.ScanRingView
                    android:id="@+id/photoRing"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:alpha="0.9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/publisher"
                        style="@style/Aegis.Label"
                        android:textColor="@color/aegis_gold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/name"
                        style="@style/Aegis.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/aegis_text"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/realName"
                        style="@style/Aegis.Mono"
                        android:textColor="@color/aegis_cyan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statAppearances"
                            style="@style/Aegis.Heading"
                            android:textColor="@color/aegis_cyan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

                        <TextView
                            style="@style/Aegis.Label"
                            android:text="@string/appearances"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statTeams"
                            style="@style/Aegis.Heading"
                            android:textColor="@color/aegis_cyan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

                        <TextView
                            style="@style/Aegis.Label"
                            android:text="@string/teams"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statFirst"
                            style="@style/Aegis.Mono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/aegis_cyan" />

                        <TextView
                            style="@style/Aegis.Label"
                            android:text="@string/first_appearance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Aegis.Section"
                    android:text="@string/threat_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Aegis.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/threatLevel"
                                style="@style/Aegis.Title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="26sp" />

                            <TextView
                                android:id="@+id/threatScore"
                                style="@style/Aegis.Mono"
                                android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
                        </LinearLayout>

                        <com.example.aegis.ui.hud.ThreatMeterView
                            android:id="@+id/threatMeter"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="10dp" />

                        <LinearLayout
                            android:id="@+id/factors"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Aegis.Section"
                    android:text="@string/about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/bio"
                    style="@style/Aegis.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Aegis.Section"
                    android:text="@string/powers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/powers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Aegis.Section"
                    android:text="@string/teams"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/teamChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Aegis.Section"
                    android:text="@string/enemies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/enemies"
                    style="@style/Aegis.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    style="@style/Aegis.Section"
                    android:text="@string/allies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/allies"
                    style="@style/Aegis.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/monitor"
                    style="@style/Aegis.Button.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/monitor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/askJarvis"
                    style="@style/Aegis.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/ask_jarvis" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_widget"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:tint="@color/aegis_cyan" />

    <com.example.aegis.ui.hud.StateView
        android:id="@+id/state"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
